{
  "manifest_version": 3,
  "name": "PySimpleManager",
  "version": "0.8.1",
  "description": "Данные доменов и аккаунтов из manager.reg.ru для PySimpleManager; сайты проверок рядом с рабочим местом. По кнопке в программе заполняет формы, но не отправляет их.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "alarms", "webRequest"],
  "host_permissions": ["https://manager.reg.ru/*", "https://identity.reg.ru/*", "https://www.gosuslugi.ru/*",
                       "https://egrul.nalog.ru/*", "https://e-trust.gosuslugi.ru/*", "https://crypto.kontur.ru/*",
                       "https://nextcloud-ms.runity.ru/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://e-trust.gosuslugi.ru/*", "https://crypto.kontur.ru/*", "https://nextcloud-ms.runity.ru/*"],
     "js": ["content/drop.js"], "all_frames": true, "run_at": "document_idle"}
  ],
  "action": {
    "default_title": "PySimpleManager",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "options_page": "options.html"
}
